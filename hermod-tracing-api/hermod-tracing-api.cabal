cabal-version: 3.0

name:                   hermod-tracing-api
version:                0.1.0
synopsis:               Thin API layer for the hermod-tracing-core tracing system
description:            Core types (Trace, MetaTrace, LogFormatting) and combinators
                        (traceWith, contramapM, foldTraceM, routingTrace) that form the
                        stable API surface of the Hermod tracing system. Packages that
                        implement or consume tracers can depend on this package without
                        pulling in the full hermod-tracing-core implementation.
category:               System,
                        Logging,
                        Tracing,
                        Metrics,
copyright:              2020-2023 Input Output Global Inc (IOG), 2023-2026 Intersect.
author:                 Juergen Nicklisch, Michael Karg, Ruslan Feizerakhmanov
maintainer:             operations@iohk.io
license:                Apache-2.0
license-files:          LICENSE
                        NOTICE
extra-doc-files:        CHANGELOG.md
                        README.md

common project-config
  default-language:     Haskell2010

  default-extensions:   LambdaCase
                        NamedFieldPuns
                        OverloadedStrings

  ghc-options:          -Wall
                        -Wcompat
                        -Wincomplete-uni-patterns
                        -Wincomplete-record-updates
                        -Wpartial-fields
                        -Widentities
                        -Wredundant-constraints
                        -Wmissing-export-lists
                        -Wno-incomplete-patterns

  if impl(ghc >= 9.8)
    ghc-options:        -Wno-x-partial


-- For internal use only. End users shall depend on the hygienic @public@ library.
library internal
  import:             project-config
  visibility:         public
  hs-source-dirs:     src/internal
  exposed-modules:    Hermod.Tracing.Trace
                      Hermod.Tracing.Trace.Combinators
                      Hermod.Tracing.Types
                      Hermod.Tracing.Types.Annotations
                      Hermod.Tracing.Types.Config
                      Hermod.Tracing.Types.Doc

  build-depends:        base >=4.12 && <5
                      , aeson >= 2.1.0.0
                      , containers
                      , contra-tracer ^>= 0.2.1
                      , deepseq
                      , hostname
                      , network
                      , serialise
                      , text
                      , unliftio
                      , unliftio-core

library public
  import:             project-config
  visibility:         public
  hs-source-dirs:     src/public
  exposed-modules:    Hermod.Tracing.API

  build-depends:        base >=4.12 && <5
                      , hermod-tracing-api:internal
                      , unliftio
                      , unliftio-core
