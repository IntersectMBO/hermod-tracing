cabal-version: 3.0

name:                   trace-dispatcher
version:                2.13.0
synopsis:               Modern, modular, configurable tracing and metrics system
description:            This is Hermod's core package and API for development of simple and efficient tracers
                        around the arrow based contra-tracer package
category:               System,
                        Logging,
                        Tracing,
                        Metrics,
copyright:              2020-2023 Input Output Global Inc (IOG), 2023-2026 Intersect.
author:                 Juergen Nicklisch, Michael Karg
maintainer:             operations@iohk.io
license:                Apache-2.0
license-files:          LICENSE
                        NOTICE
extra-doc-files:        CHANGELOG.md
                        README.md
                        doc/trace-dispatcher.md

common project-config
  default-language:     Haskell2010

  default-extensions:   LambdaCase
                        NamedFieldPuns
                        OverloadedStrings

  ghc-options:          -Wall
                        -Wcompat
                        -Wincomplete-uni-patterns
                        -Wincomplete-record-updates
                        -Wpartial-fields
                        -Widentities
                        -Wredundant-constraints
                        -Wmissing-export-lists

  if impl(ghc >= 9.8)
    ghc-options:        -Wno-x-partial


library
  import:             project-config
  hs-source-dirs:     src
  exposed-modules:    Hermod.Tracing
                      Hermod.Tracing.Configuration
                      Hermod.Tracing.ConfigurationParser
                      Hermod.Tracing.Consistency
                      Hermod.Tracing.DocuGenerator
                      Hermod.Tracing.Formatter
                      Hermod.Tracing.FrequencyLimiter
                      Hermod.Tracing.Prometheus.Exposition
                      Hermod.Tracing.Prometheus.NetworkRun
                      Hermod.Tracing.Prometheus.TCPServer
                      Hermod.Tracing.TraceDispatcherMessage
                      Hermod.Tracing.Tracer.DataPoint
                      Hermod.Tracing.Tracer.EKG
                      Hermod.Tracing.Tracer.Standard
                      Hermod.Tracing.Tracer.Forward
                      Hermod.Tracing.Tracer.Composed
                      Hermod.Tracing.Types.NodeInfo
                      Hermod.Tracing.Types.NodeStartupInfo
                      Hermod.Tracing.Types.TraceMessage
                      Hermod.Tracing.Utils

  other-modules:      Hermod.Tracing.Types.DocuGenerator

  build-depends:        base >=4.12 && <5
                      , hermod-tracing-api
                      , aeson >= 2.1.0.0
                      , aeson-pretty
                      , async
                      , bytestring
                      , cborg
                      , cborg-json
                      , containers
                      , contra-tracer ^>= 0.2.1
                      , deepseq
                      , directory
                      , ekg-core
                      , filepath
                      , hashable
                      , hostname
                      , http-date
                      , network
                      , serialise
                      , stm
                      , text
                      , time
                      , time-manager
                      , unagi-chan >= 0.4.1.4
                      , unix-compat
                      , unliftio
                      , unliftio-core
                      , unordered-containers
                      , yaml

  if os(windows)
     build-depends:     Win32
  else
     build-depends:     unix


test-suite trace-dispatcher-test
  import:               project-config
  type:                 exitcode-stdio-1.0
  hs-source-dirs:       test
  main-is:              trace-dispatcher-test.hs
  other-modules:        Hermod.Tracing.Test.Types
                        Hermod.Tracing.Test.Oracles
                        Hermod.Tracing.Test.Config
                        Hermod.Tracing.Test.Tracer
                        Hermod.Tracing.Test.Script
                        Hermod.Tracing.Test.Unit.TestObjects
                        Hermod.Tracing.Test.Unit.Aggregation
                        Hermod.Tracing.Test.Unit.Trivial
                        Hermod.Tracing.Test.Unit.Routing
                        Hermod.Tracing.Test.Unit.EKG
                        Hermod.Tracing.Test.Unit.Configuration
                        Hermod.Tracing.Test.Unit.DataPoint
                        Hermod.Tracing.Test.Unit.FrequencyLimiting
                        Hermod.Tracing.Test.Unit.Documentation

  ghc-options:          -Wno-incomplete-patterns

  build-depends:        base >=4.12 && <5
                      , aeson
                      , bytestring
                      , containers
                      , deepseq
                      , ekg-core
                      , generic-data
                      , hostname
                      , text
                      , stm
                      , tasty
                      , tasty-hunit
                      , tasty-quickcheck
                      , time
                      , trace-dispatcher
                      , unordered-containers
                      , utf8-string
                      , yaml
                      , QuickCheck


benchmark trace-dispatcher-bench
  import:               project-config
  type:                 exitcode-stdio-1.0
  hs-source-dirs:       bench, test
  main-is:              trace-dispatcher-bench.hs

  other-modules:        Hermod.Tracing.Test.Types
                        Hermod.Tracing.Test.Oracles
                        Hermod.Tracing.Test.Config
                        Hermod.Tracing.Test.Tracer
                        Hermod.Tracing.Test.Script

  ghc-options:          -Wno-incomplete-patterns

  build-depends:        base >=4.12 && <5
                      , aeson
                      , containers
                      , criterion
                      , ekg-core
                      , text
                      , time
                      , trace-dispatcher
                      , QuickCheck
